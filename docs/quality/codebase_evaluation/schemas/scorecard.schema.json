{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cef.local/schemas/scorecard.schema.json",
  "title": "CEF Diamond Scorecard",
  "type": "object",
  "required": ["cef_version", "axes", "assessed_at"],
  "properties": {
    "cef_version": { "type": "string", "const": "0.1.0" },
    "assessed_at": { "type": "string" },
    "repo_fingerprint": { "type": "string" },
    "axes": {
      "type": "object",
      "required": ["RDB", "MNT", "TST", "REL", "OBS", "RCV", "SEC", "ROB"],
      "additionalProperties": false,
      "properties": {
        "RDB": { "$ref": "#/$defs/axisGrade" },
        "MNT": { "$ref": "#/$defs/axisGrade" },
        "TST": { "$ref": "#/$defs/axisGrade" },
        "REL": { "$ref": "#/$defs/axisGrade" },
        "OBS": { "$ref": "#/$defs/axisGrade" },
        "RCV": { "$ref": "#/$defs/axisGrade" },
        "SEC": { "$ref": "#/$defs/axisGrade" },
        "ROB": { "$ref": "#/$defs/axisGrade" }
      }
    },
    "optional_axes": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/axisGrade" }
    },
    "integrator": { "type": "string" },
    "notes": { "type": "string" }
  },
  "$defs": {
    "axisGrade": {
      "type": "object",
      "required": ["grade", "confidence", "drivers"],
      "properties": {
        "grade": { "type": "integer", "minimum": 1, "maximum": 5 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "drivers": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 5
        },
        "notes": { "type": "string" }
      }
    }
  }
}
