# syntax=docker/dockerfile:1.7

# Stage 1: Build product binary
FROM golang:1.26-alpine AS builder

WORKDIR /build
RUN apk add --no-cache git make

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /build/bin/zqk ./cmd/zqk

# Stage 2: Minimal runtime image
FROM alpine:3.21 AS runner

RUN apk add --no-cache ca-certificates git bash curl \
    && adduser -D -u 10001 -s /bin/bash zqk \
    && mkdir -p /workspace /home/zqk/.zqk \
    && chown -R zqk:zqk /workspace /home/zqk

COPY --from=builder /build/bin/zqk /usr/local/bin/zqk

USER 10001
WORKDIR /workspace
ENV HOME=/home/zqk
ENV ZQK_CONTEXT=ai-agent

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD ["/usr/local/bin/zqk", "system", "status", "--quiet"] || exit 1

ENTRYPOINT ["/usr/local/bin/zqk"]
CMD ["--help"]
