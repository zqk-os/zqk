-- Generated by zqk (default token sequence; set ZQK_CURSOR_PASTE_PREFIX_STEPS to customize)
-- Tokens: cmd_y
-- See: cmd/zqk/scheduler/ide_paste_automation.go
--

log "zqk agent_prompt: step=activate_ide"
tell application "Cursor" to activate
delay 0.5
tell application "System Events"
	set zqkCP to missing value
	try
		set zqkCP to first application process whose name is "Cursor" and frontmost is true
	end try
	if zqkCP is missing value then
		try
			set zqkCP to first application process whose name is "Cursor"
		end try
	end if
	if zqkCP is missing value then
		error "zqk agent_prompt: no application process named exactly " & "Cursor" & " (is the IDE running?)"
	end if
	try
		log "zqk agent_prompt: step=resolved_process unix_id=" & (unix id of zqkCP)
	end try
	tell zqkCP
		set frontmost to true
		delay 0.25
		log "zqk agent_prompt: step=focus_ide_chat_cmd_y"
		keystroke "y" using command down
		delay 0.4
		log "zqk agent_prompt: step=keystroke_cmd_v_paste"
		keystroke "v" using command down
		delay 0.3
		log "zqk agent_prompt: step=key_code_36_return_submit"
		key code 36
	end tell
end tell
log "zqk agent_prompt: step=sequence_complete"
