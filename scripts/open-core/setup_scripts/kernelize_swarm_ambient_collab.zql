UPSERT requirement ID "REQ-SWARM-HETEROGENEOUS-DELEGATION-001" {
  "title": "Heterogeneous Multi-Model Delegation & Collaboration",
  "description": "The swarm orchestrator MUST support capability- and tier-based dispatch that splits assignments between local swarm workers (e.g., routine/eval tasks via Ollama) and hosted subagents (e.g., complex synthesis via Gemini) with shared agent_feed collaboration.",
