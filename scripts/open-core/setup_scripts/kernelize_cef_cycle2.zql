UPSERT technical_debt ID "TDE-F-SECURITY-AUDITOR-KEY-FALLBACK-001" {
  "title": "AuditorGate falls back to unencrypted disk keystore when CAS entry is absent",
  "description": "In AuditorGate.trustedPubHex, when the key object KEY-AUDITOR-001 is missing from CAS, the system falls back to loading .zqk/keystore/auditor.priv from the local disk filesystem without hardware security module or keychain binding.",
  "debt_type": "security",
  "impact_assessment": "low",
  "priority": "low",
  "target_resolution_date": "2026-12-01",
  "tags": ["cef", "l-security", "low", "finding:F-SECURITY-AUDITOR-KEY-FALLBACK-001"],
  "namespace_id": "zqk:kernel",
  "schema_version": "2.0.0",
  "status": "resolved",
  "resolution_notes": "Added strict keystore fallback policy to AuditorGate preventing unencrypted disk private key fallback when KEY-AUDITOR-001 is missing from CAS (commit b2e89d5f).",
  "completed_at": "2026-09-25T22:14:43Z",
  "file_path": "pkg/validation/qa/gate.go"
