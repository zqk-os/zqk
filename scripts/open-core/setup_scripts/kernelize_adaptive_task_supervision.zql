BEGIN TRANSACTION;

UPSERT goal ID "GOAL-ADAPTIVE-TASK-SUPERVISION-001" {
    "title": "Agnostic Adaptive Task Supervision & Failure Delta Illumination",
    "description": "Enhance agent retry success probability by objectifying and injecting structured failure deltas, negative hypothesis pruning, canonical exemplars, progressive scope narrowing, and idempotent deduplication into orchestration.",
    "metric": "retry_resolution_rate",
    "target": ">=90%",
    "status": "active"
};

