        "description": "Mandatory project-agnostic spine: decompose all collaborative work into\nindependently verifiable chunks across intent→design→implement→integrate→operate.\nRigid stages and hard gates; preferences (lint, test runner, style) live in\ncustomization only. Chat claims of done without evidence are violations.\n",
        "enforcement_level": "blocking",
        "rules": [
          {
            "description": "One chunk equals one independently verifiable claim; no deferred proof across stages.",
            "id": "VDS-R1"
          },
          {
            "description": "Narrative is never evidence; evidence_refs must be re-runnable footprints.",
            "id": "VDS-R2"
          },
          {
            "description": "Stage advance requires independent_verify=yes for all stage chunks or human waiver_ref.",
            "id": "VDS-R3"
          },
          {
            "description": "Customization may change how checks run, never whether gates exist.",
            "id": "VDS-R4"
          },
          {
            "description": "Orchestrators and merge/close paths must refuse unverified done for in-scope chunks.",
            "id": "VDS-R5"
          },
          {
            "description": "Waivers are human-authored durable objects only; agents must not self-waive.",
            "id": "VDS-R6"
          },
          {
            "description": "Empty dsl_checks or empty evidence_refs is a hard fail for any done claim.",
            "id": "VDS-R7"
          }
        ],
        "severity": "critical"
      },
