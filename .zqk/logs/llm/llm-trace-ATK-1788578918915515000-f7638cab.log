, got %d\\\", len(result))\\n\\t}\\n\\n\\tif NewOpenCoreInventory() == nil {\\n\\t\\tt.Error(\\\"NewOpenCoreInventory returned nil for default config\\\")\\n\\t}\\n\\n\\tcfg := OpenCoreConfig{\\n\\t\\tMinimizeCommercialPathDepth: 0,\\n\\t}\\n\\tinvent := NewOpenCoreInventoryWithConfig(cfg)\\n\\tif invent == nil {\\n\\t\\tt.Error(\\\"NewOpenCoreInventoryWithConfig returned nil\\\")\\n\\t}\\n}\\n\\n// TestOpenCoreConfigSensibleDefaults verifies the default config is reasonable.\\nfunc TestOpenCoreConfigSensibleDefaults(t *testing.T) {\\n\\tcfg := DefaultOpenCoreConfig()\\n\\tif cfg.MinimizeCommercialPathDepth \\u003c 0 {\\n\\t\\tt.Errorf(\\\"unexpected negative MinimizeCommercialPathDepth: %d\\\", cfg.MinimizeCommercialPathDepth)\\n\\t}\\n\\n\\t// Path prefixes that indicate commercial code should be non-empty.\\n\\tif len(cfg.CommercialPathPrefixes) == 0 {\\n\\t\\tt.Error(\\\"expected at least one CommercialPathPrefix in default config\\\")\\n\\t}\\n\\n\\t// Internal domains should be non-empty.\\n\\tif len(cfg.InternalDomains) == 0 {\\n\\t\\tt.Error(\\\"expected at least one InternalDomain in default config\\\")\\n\\t}\\n}\\n\\n// TestOpenCoreFindingSeverityOrder checks severity ordering is well-defined.\\nfunc TestOpenCoreFindingSeverityOrder(t *testing.T) {\\n\\tfindings := []OpenCoreFinding{\\n\\t\\t{Kind: \\\"critical\\\", Path: \\\"pkg/evil.go\\\", Severity: \\\"error\\\"},\\n\\t\\t{Kind: \\\"warn\\\", Path: \\\"pkg/suspicious.go\\\", Severity: \\\"warn\\\"},\\n\\t\\t{Kind: \\\"ok\\\", Path: \\\"pkg/clean.go\\\", Severity: \\\"\\\"},\\n\\t}\\n\\n\\tsorted := SortFindingsBySeverity(findings)\\n\\n\\tif len(sorted) != 3 {\\n\\t\\tt.Fatalf(\\\"expected 3 findings after sort, got %d\\\", len(sorted))\\n\\t}\\n\\n\\t// Critical/error should come before warn.\\n\\tif sorted[0].Severity != \\\"error\\\" {\\n\\t\\tt.Errorf(\\\"expected first finding to be error severity, got %s\\\", sorted[0].Severity)\\n\\t}\\n\\n\\t// OK items should sort to the end.\\n\\tif sorted[2