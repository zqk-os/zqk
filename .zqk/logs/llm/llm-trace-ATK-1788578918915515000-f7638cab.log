    "arguments": "{\"content\":\"package processhygiene\\n\\nimport (\\n\\t\\\"testing\\\"\\n)\\n\\n// TestOpenCoreInventoryNoCommercialLeak checks that open-core inventory correctly flags commercial-only references.\\nfunc TestOpenCoreInventoryNoCommercialLeak(t *testing.T) {\\n\\t// Inventory entries should include a kind, path, and severity level.\\n\\tentries := []OpenCoreFinding{\\n\\t\\t{Kind: \\\"commercial_ref\\\", Path: \\\"pkg/enterprise/license.go\\\", Severity: \\\"warn\\\"},\\n\\t\\t{Kind: \\\"internal_domain\\\", Path: \\\"services/internal/auth.go\\\", Severity: \\\"error\\\"},\\n\\t\\t{Kind: \\\"ok\\\", Path: \\\"pkg/client/agent.go\\\", Severity: \\\"\\\"},\\n\\t}\\n\\n\\t// Commercial leaks should be detected.\\n\\tcommercialCount := countByKind(entries, \\\"commercial_ref\\\")\\n\\tif commercialCount != 1 {\\n\\t\\tt.Errorf(\\\"expected 1 commercial_ref, got %d\\\", commercialCount)\\n\\t}\\n\\n\\t// Internal domain refs should be detected.\\n\\tinternalCount := countByKind(entries, \\\"internal_domain\\\")\\n\\tif internalCount != 1 {\\n\\t\\tt.Errorf(\\\"expected 1 internal_domain, got %d\\\", internalCount)\\n\\t}\\n\\n\\t// Clean entries should not be counted as issues.\\n\\tokCount := countByKind(entries, \\\"ok\\\")\\n\\tif okCount != 1 {\\n\\t\\tt.Errorf(\\\"expected 1 ok entry, got %d\\\", okCount)\\n\\t}\\n\\n\\t// Total findings (non-ok) should equal commercial + internal.\\n\\ttotalFindings := len(FindCommercialLeaks(entries))\\n\\texpectedTotal := 2 // commercial_ref + internal_domain\\n\\tif totalFindings != expectedTotal {\\n\\t\\tt.Errorf(\\\"expected %d total findings, got %d\\\", expectedTotal, totalFindings)\\n\\t}\\n}\\n\\n// TestOpenCoreInventoryEmptyInput verifies the inventory handles empty input gracefully.\\nfunc TestOpenCoreInventoryEmptyInput(t *testing.T) {\\n\\tvar entries []OpenCoreFinding\\n\\n\\tresult := FindCommercialLeaks(entries)\\n\\tif len(result) != 0 {\\n\\t\\tt.Errorf(\\\"expected no findings for empty input, got %d\\\", len(result))\\n\\t}\\n\\n\\tif NewOpenCoreInventory() == nil {\\n\\t\\tt.Error(\\\"NewOpenCoreInventory returned nil for default config\\\")\\n\\t}\\n\\n\\tcfg := OpenCoreConfig{\\n\\t\\tMinimizeCommercialPathDepth: 0,\\n\\t}\\n\\tinvent := NewOpenCoreInventoryWithConfig(cfg)\\n\\tif invent == nil {\\n\\t\\tt.Error(\\\"NewOpenCoreInventoryWithConfig returned nil\\\")\\n\\t}\\n}\\n\\n// TestOpenCoreConfigSensibleDefaults verifies the default config is reasonable.\\nfunc TestOpenCoreConfigSensibleDefaults(t *testing.T) {\\n\\tcfg := DefaultOpenCoreConfig()\\n\\tif cfg.MinimizeCommercialPathDepth \\u003c 0 {\\n\\t\\tt.Errorf(\\\"unexpected negative MinimizeCommercialPathDepth: %d\\\", cfg.MinimizeCommercialPathDepth)\\n\\t}\\n\\n\\t// Path prefixes that indicate commercial code should be non-empty.\\n\\tif len(cfg.CommercialPathPrefixes) == 0 {\\n\\t\\tt.Error(\\\"expected at least one CommercialPathPrefix in default config\\\")\\n\\t}\\n\\n\\t// Internal domains should be non-empty.\\n\\tif len(cfg.InternalDomains) == 0 {\\n\\t\\tt.Error(\\\"expected at least one InternalDomain in default config\\\")\\n\\t}\\n}\\n\\n// TestOpenCoreFindingSeverityOrder checks severity ordering is well-defined.\\nfunc TestOpenCoreFindingSeverityOrder(t *testing.T) {\\n\\tfindings := []OpenCoreFinding{\\n\\t\\t{Kind: \\\"critical\\\", Path: \\\"pkg/evil.go\\\", Severity: \\\"error\\\"},\\n\\t\\t{Kind: \\\"warn\\\", Path: \\\"pkg/suspicious.go\\\", Severity: \\\"warn\\\"},\\n\\t\\t{Kind: \\\"ok\\\", Path: \\\"pkg/clean.go\\\", Severity: \\\"\\\"},\\n\\t}\\n\\n\\tsorted := SortFindingsBySeverity(findings)\\n\\n\\tif len(sorted) != 3 {\\n\\t\\tt.Fatalf(\\\"expected 3 findings after sort, got %d\\\", len(sorted))\\n\\t}\\n\\n\\t// Critical/error should come before warn.\\n\\tif sorted[0].Severity != \\\"error\\\" {\\n\\t\\tt.Errorf(\\\"expected first finding to be error severity, got %s\\\", sorted[0].Severity)\\n\\t}\\n\\n\\t// OK items should sort to the end.\\n\\tif sorted[2].Severity != \\\"\\\" {\\n\\t\\tt.Errorf(\\\"expected last finding to have empty severity (ok), got %s\\\", sorted[2].Severity)\\n\\t}\\n}\\n\\n// TestCountByKindWithMultipleKinds verifies counting works across distinct kinds.\\nfunc TestCountByKindWithMultipleKinds(t *testing.T) {\\n\\tentries := []OpenCoreFinding{\\n\\t\\t{Kind: \\\"commercial_ref\\\", Path: \\\"a.go\\\"},\\n\\t\\t{Kind: \\\"commercial_ref\\\", Path: \\\"b.go\\\"},\\n\\t\\t{Kind: \\\"internal_domain\\\", Path: \\\"c.go\\\"},\\n\\t\\t{Kind: \\\"secret_candidate\\\", Path: \\\"d.go\\\"},\\n\\t\\t{Kind: \\\"ok\\\", Path: \\\"e.go\\\"},\\n\\t}\\n\\n\\tif n := countByKind(entries, \\\"commercial_ref\\\"); n != 2 {\\n\\t\\tt.Errorf(\\\"expected 2 commercial_ref, got %d\\\", n)\\n\\t}\\n\\tif n := countByKind(entries, \\\"internal_domain\\\"); n != 1 {\\n\\t\\tt.Errorf(\\\"expected 1 internal_domain, got %d\\\", n)\\n\\t}\\n\\tif n := countByKind(entries, \\\"secret_candidate\\\"); n != 1 {\\n\\t\\tt.Errorf(\\\"expected 1 secret_candidate, got %d\\\", n)\\n\\t}\\n\\tif n := countByKind(entries, \\\"ok\\\"); n != 1 {\\n\\t\\tt.Errorf(\\\"expected 1 ok, got %d\\\", n)\\n\\t}\\n}\\n\\n// TestInventoryContains checks membership.\\nfunc TestInventoryContains(t *testing.T) {\\n\\tinv := NewOpenCoreInventory()\\n\\tinv.AddFinding(OpenCoreFinding{Kind: \\\"test_kind\\\", Path: \\\"path/to/file.go\\\"})\\n\\tif !inv.Contains(\\\"test_kind\\\", \\\"path/to/file.go\\\") {\\n\\t\\tt.Error(\\\"expected Contains to return true, got false\\\")\\n\\t}\\n\\n\\t// Non-existent kind.\\n\\tif inv.Contains(\\\"nonexistent_kind\\\", \\\"path/to/file.go\\\") {\\n\\t\\tt.Error(\\\"expected Contains to return false for non-existent kind\\\")\\n\\t}\\n\\n\\t// Existing kind but different path.\\n\\tif inv.Contains(\\\"test_kind\\\", \\\"different/path.go\\\") {\\n\\t\\tt.Error(\\\"expected Contains to return false for different path\\\")\\n\\t}\\n}\\n\",\"path\":\"pkg/processhygiene/opencore_inventory_test.go\"}"
  }
