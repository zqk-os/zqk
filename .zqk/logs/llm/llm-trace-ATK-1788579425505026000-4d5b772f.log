!= nil {\\n\\t\\tt.Fatalf(\\\"write go.mod: %v\\\", err)\\n\\t}\\n\\tt.Setenv(\\\"PWD\\\", tmpDir)\\n\\n\\tdoc, err := GenerateSBOM(tmpDir)\\n\\tif err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tif !containsSubstring(doc, \\\"x/text\\\") \\u0026\\u0026 !containsSubstring(doc, \\\"text\\\") {\\n\\t\\tt.Error(\\\"expected SBOM to contain dependency name\\\")\\n\\t}\\n}\\n\\n// Helper: check if substring exists (avoid import dep just for this test)\\nfunc checkBOMType(doc string) bool {\\n\\treturn containsSubstring(doc, \\\"cyclonedx\\\") || containsSubstring(doc, \\\"CycloneDX\\\") || containsSubstring(doc, \\\"bomFormat\\\")\\n}\\n\\ntype sbomFormatChecker struct{}\\n\\nfunc (c *sbomFormatChecker) checkBOMType(s string) bool { return c.checkBOMTypeImpl(s) }\\n\\nfunc containsSubstring(s, sub string) bool {\\n\\tfor i := 0; i \\u003c= len(s)-len(sub); i++ {\\n\\t\\tif s[i:i+len(sub)] == sub {\\n\\t\\t\\treturn true\\n\\t\\t}\\n\\t}\\n\\treturn false\\n}\\n\\n// TSBOM-R4: GenerateSBOM errors on invalid module directory\\nfunc TestGenerateSBOM_BadModuleDir(t *testing.T) {\\n\\ttmpDir := t.TempDir()\\n\\t_, err := GenerateSBOM(tmpDir)\\n\\tif err == nil {\\n\\t\\tt.Fatal(\\\"expected error for non-modules directory\\\")\\n\\t}\\n}\\n\\n// TSBOM-R5: sbomDocument serializes to valid JSON bytes\\nfunc TestDocument_MarshalJSON(t *testing.T) {\\n\\tdoc := \\u0026sbomDocument{\\n\\t\\tBOMFormat: \\\"CycloneDX\\\",\\n\\t\\tSpecVersion: \\\"1.5\\\",\\n\\t\\tMetadata: sbomMetadata{\\n\\t\\t\\tTimestamp: \\\"2025-01-01T00:00:00Z\\\",\\n\\t\\t\\tTools:     []nameVersion{{Name: \\\"zqk-sbom\\\"}},\\n\\t\\t},\\n\\t\\tComponents: []component{},\\n\\t}\\n\\tdata, err := doc.MarshalJSON()\\n\\tif err != nil {\\n\\t\\tt.Fatalf(\\\"MarshalJSON(): %v\\\", err)\\n\\t}\\n\\tif len(data) == 0 {\\n\\t\\tt.Fatal(\\\"expected non-empty serialized SBOM\\\")\\n\\t}\\n}\\n\\n// TSBOM-R6: sbomDocument serializes with correct field names (CycloneDX spec)\\nfunc TestDocument_MarshalJSON_Fields(t *test