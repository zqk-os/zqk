wrong name count: want %d, got %d\\\"\\n\\terrNameIndexMismatch     = \\\"name at index %d mismatch: want %q, got %q\\\"\\n)\\n\\n// TestPayloadCheck_NewChecker verifies NewPayloadChecker returns non-nil, no push or pull.\\nfunc TestPayloadCheck_NewChecker(t *testing.T) {\\n\\tt.Run(\\\"returns_non_nil\\\", func(t *testing.T) {\\n\\t\\tchecker := NewPayloadChecker()\\n\\t\\tif checker == nil {\\n\\t\\t\\tt.Fatal(errNewCheckerNil)\\n\\t\\t}\\n\\t})\\n\\n\\tt.Run(\\\"not_pushed_initially\\\", func(t *testing.T) {\\n\\t\\tchecker := NewPayloadChecker()\\n\\t\\tok := checker.WasPushed()\\n\\t\\tif ok {\\n\\t\\t\\tt.Fatal(errPushedBeforeOp)\\n\\t\\t}\\n\\t})\\n\\n\\tt.Run(\\\"not_pulled_initially\\\", func(t *testing.T) {\\n\\t\\tchecker := NewPayloadChecker()\\n\\t\\tok := checker.WasPulled()\\n\\t\\tif ok {\\n\\t\\t\\tt.Fatal(errPulledBeforeOP)\\n\\t\\t}\\n\\t})\\n}\\n\\n// TestPayloadCheck_NewCheckerWithOpts verifies functional options work correctly.\\nfunc TestPayloadCheck_NewCheckerWithOpts(t *testing.T) {\\n\\tconst (\\n\\t\\ttestBranch = \\\"v1.0.0\\\"\\n\\t\\ttestURL    = \\\"https://example.com/api\\\"\\n\\t)\\n\\n\\tchecker := NewPayloadCheckerWithOpts(\\n\\t\\tWithBranch(testBranch),\\n\\t\\tWithBaseURL(testURL),\\n\\t)\\n\\n\\tt.Run(\\\"not_nil_after_opts\\\", func(t *testing.T) {\\n\\t\\tif checker == nil {\\n\\t\\t\\tt.Fatal(errOptsNil)\\n\\t\\t}\\n\\t})\\n\\n\\tt.Run(\\\"branch_option_applied\\\", func(t *testing.T) {\\n\\t\\tgot := checker.branch\\n\\t\\tif got != testBranch {\\n\\t\\t\\tt.Fatalf(errBranchMismatch, testBranch, got)\\n\\t\\t}\\n\\t})\\n\\n\\tt.Run(\\\"baseURL_option_applied\\\", func(t *testing.T) {\\n\\t\\tgot := checker.baseURL\\n\\t\\tif got != testURL {\\n\\t\\t\\tt.Fatalf(errURLMismatch, testURL, got)\\n\\t\\t}\\n\\t})\\n}\\n\\n// TestPayloadCheck_CheckAll_returnsResults verifies CheckAll returns a non-empty slice.\\nfunc TestPayloadCheck_CheckAll_returnsResults(t *testing.T) {\\n\\tchecker := NewPayloadChecker()\\n\\tresults := chec