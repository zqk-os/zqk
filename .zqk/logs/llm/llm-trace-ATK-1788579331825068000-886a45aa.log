wrong name count: want %d, got %d\\\"\\n\\terrNameIndexMismatch     = \\\"name at index %d mismatch: want %q, got %q\\\"\\n)\\n\\n// TestPayloadCheck_NewChecker verifies NewPayloadChecker returns non-nil, no push or pull.\\nfunc TestPayloadCheck_NewChecker(t *testing.T) {\\n\\tt.Run(\\\"returns_non_nil\\\", func(t *testing.T) {\\n\\t\\tchecker := NewPayloadChecker()\\n\\t\\tif checker == nil {\\n\\t\\t\\tt.Fatal(errNewCheckerNil)\\n\\t\\t}\\n\\t})\\n\\n\\tt.Run(\\\"not_pushed_initially\\\", func(t *testing.T) {\\n\\t\\tchecker := NewPayloadChecker()\\n\\t\\tok := checker.WasPushed()\\n\\t\\tif ok {\\n\\t\\t\\tt.Fatal(errPushedBeforeOp)\\n\\t\\t}\\n\\t})\\n\\n\\tt.Run(\\\"not_pulled_initially\\\", func(t *testing.T) {\\n\\t\\tchecker := NewPayloadChecker()\\n\\t\\tok := checker.WasPulled()\\n\\t\\tif ok {\\n\\t\\t\\tt.Fatal(errPulledBeforeOP)\\n\\t\\t}\\n\\t})\\n}\\n\\n// TestPayloadCheck_NewCheckerWithOpts verifies functional options work correctly.\\nfunc TestPayloadCheck_NewCheckerWithOpts(t *testing.T) {\\n\\tconst (\\n\\t\\ttestBranch = \\\"v1.0.0\\\"\\n\\t\\ttestURL    = \\\"https://example.com/api\\\"\\n\\t)\\n\\n\\tchecker := NewPayloadCheckerWithOpts(\\n\\t\\tWithBranch(testBranch),\\n\\t\\tWithBaseURL(testURL),\\n\\t)\\n\\n\\tt.Run(\\\"not_nil_after_opts\\\", func(t *testing.T) {\\n\\t\\tif checker == nil {\\n\\t\\t\\tt.Fatal(errOptsNil)\\n\\t\\t}\\n\\t})\\n\\n\\tt.Run(\\\"branch_option_applied\\\", func(t *testing.T) {\\n\\t\\tgot := checker.branch\\n\\t\\tif got != testBranch {\\n\\t\\t\\tt.Fatalf(errBranchMismatch, testBranch, got)\\n\\t\\t}\\n\\t})\\n\\n\\tt.Run(\\\"baseURL_option_applied\\\", func(t *testing.T) {\\n\\t\\tgot := checker.baseURL\\n\\t\\tif got != testURL {\\n\\t\\t\\tt.Fatalf(errURLMismatch, testURL, got)\\n\\t\\t}\\n\\t})\\n}\\n\\n// TestPayloadCheck_CheckAll_returnsResults verifies CheckAll returns a non-empty slice.\\nfunc TestPayloadCheck_CheckAll_returnsResults(t *testing.T) {\\n\\tchecker := NewPayloadChecker()\\n\\tresults := checker.CheckAll()\\n\\n\\tt.Run(\\\"not_nil\\\", func(t *testing.T) {\\n\\t\\tif results == nil {\\n\\t\\t\\tt.Fatal(errCheckAllNil)\\n\\t\\t}\\n\\t})\\n\\n\\tt.Run(\\\"has_entries\\\", func(t *testing.T) {\\n\\t\\tn := len(results)\\n\\t\\tif n == 0 {\\n\\t\\t\\tt.Fatalf(errCheckAllZero)\\n\\t\\t}\\n\\t\\t_ = n\\n\\t})\\n}\\n\\n// TestPayloadCheck_AllGreen verifies that under default settings every check reports passed.\\nfunc TestPayloadCheck_AllGreen(t *testing.T) {\\n\\tchecker := NewPayloadChecker()\\n\\tresults := checker.CheckAll()\\n\\n\\tfor _, r := range results {\\n\\t\\tname := r.Name\\n\\t\\tif !r.Passed {\\n\\t\\t\\tt.Fatalf(errCheckUnexpectedFail, name)\\n\\t\\t}\\n\\t}\\n}\\n\\n// TestPayloadCheck_NoPushVerified confirms no public push occurs in default PayloadChecker.\\nfunc TestPayloadCheck_NoPushVerified(t *testing.T) {\\n\\tchecker := NewPayloadChecker()\\n\\tresults := checker.CheckAll()\\n\\n\\tif !AllPassed(results) {\\n\\t\\tt.Fatal(errChecksNotPassing)\\n\\t}\\n\\n\\tpushed := checker.WasPushed()\\n\\tif pushed {\\n\\t\\tt.Fatal(errPublicPushOccurred)\\n\\t}\\n}\\n\\n// TestPayloadCheck_CheckResult_WasPulled verifies newly constructed results are clean.\\nfunc TestPayloadCheck_CheckResult_WasPulled(t *testing.T) {\\n\\tr := CheckResult{\\n\\t\\tName:   \\\"test\\\",\\n\\t\\tPassed: true,\\n\\t}\\n\\tif r.WasPulled {\\n\\t\\tt.Fatal(errWasPulledSetFresh)\\n\\t}\\n}\\n\\n// TestPayloadCheck_NoOptionsStillSetsDefaults verifies defaults when no options given.\\nfunc TestPayloadCheck_NoOptionsStillSetsDefaults(t *testing.T) {\\n\\tchecker := NewPayloadCheckerWithOpts()\\n\\n\\tif checker.branch != \\\"main\\\" {\\n\\t\\tt.Fatalf(errDefaultBranch, checker.branch)\\n\\t}\\n\\t_ = checker.baseURL\\n\\n\\tif checker.WasPushed() {\\n\\t\\tt.Fatal(errDefaultPushed)\\n\\t}\\n}\\n\\n// TestPayloadCheck_AuditTrail verifies that the internal audit list records each check.\\nfunc TestPayloadCheck_AuditTrail(t *testing.T) {\\n\\tchecker := NewPayloadChecker()\\n\\terr := new(error)\\n\\t_ = err // avoid direct blank-identifier assignment\\n\\tresults := checker.CheckAll()\\n\\n\\tif len(checker.checksAt) == 0 {\\n\\t\\tt.Fatal(errAuditEmpty)\\n\\t}\\n\\n\\texpectedChecks := []string{checkBuildReady, checkModuleHealth, checkDependencyIntegrity, checkNoPush}\\n\\n\\tfor _, want := range expectedChecks {\\n\\t\\tfound := false\\n\\t\\tfor _, got := range checker.checksAt {\\n\\t\\t\\tif got == want {\\n\\t\\t\\t\\tfound = true\\n\\t\\t\\t\\tbreak\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\tif !found {\\n\\t\\t\\tt.Fatalf(errMissingInAudit, want)\\n\\t\\t}\\n\\t}\\n}\\n\\n// TestAllPassed_edgeCases exercises the AllPassed helper on boundary inputs.\\nfunc TestAllPassed_edgeCases(t *testing.T) {\\n\\tt.Run(\\\"nil_input_returns_false\\\", func(t *testing.T) {\\n\\t\\tif AllPassed(nil) {\\n\\t\\t\\tt.Fatal(errAllPassedNilSlice)\\n\\t\\t}\\n\\t})\\n\\n\\tt.Run(\\\"empty_input_returns_false\\\", func(t *testing.T) {\\n\\t\\tif AllPassed([]CheckResult{}) {\\n\\t\\t\\tt.Fatal(errAllPassedEmptySlice)\\n\\t\\t}\\n\\t})\\n\\n\\tt.Run(\\\"all_green_returns_true\\\", func(t *testing.T) {\\n\\t\\tallGreen := []CheckResult{\\n\\t\\t\\t{Name: \\\"a\\\", Passed: true},\\n\\t\\t\\t{Name: \\\"b\\\", Passed: true},\\n\\t\\t}\\n\\t\\tif !AllPassed(allGreen) {\\n\\t\\t\\tt.Fatal(errAllGreenNot)\\n\\t\\t}\\n\\t})\\n\\n\\tt.Run(\\\"mixed_returns_false\\\", func(t *testing.T) {\\n\\t\\tmixed := []CheckResult{\\n\\t\\t\\t{Name: \\\"a\\\", Passed: true},\\n\\t\\t\\t{Name: \\\"b\\\", Passed: false},\\n\\t\\t}\\n\\t\\tif AllPassed(mixed) {\\n\\t\\t\\tt.Fatal(errMixedShouldNot)\\n\\t\\t}\\n\\t})\\n\\n\\tt.Run(\\\"all_red_returns_false\\\", func(t *testing.T) {\\n\\t\\tallRed := []CheckResult{\\n\\t\\t\\t{Name: \\\"a\\\", Passed: false},\\n\\t\\t}\\n\\t\\tif AllPassed(allRed) {\\n\\t\\t\\tt.Fatal(errAllRedShouldNot)\\n\\t\\t}\\n\\t})\\n}\\n\\n// TestPayloadChecker_ManualPushBlocked verifies no code path permits push.\\nfunc TestPayloadChecker_ManualPushBlocked(t *testing.T) {\\n\\tchecker := NewPayloadChecker()\\n\\tresults := checker.CheckAll()\\n\\tok := AllPassed(results)\\n\\tif !ok {\\n\\t\\tt.Fatal(errManualCheckFailed)\\n\\t}\\n\\tpushed := checker.WasPushed()\\n\\tif pushed {\\n\\t\\tt.Fatal(errManualPushBlocked)\\n\\t}\\n}\\n\\n// TestCheckNames verifies the exported name list matches internal constants.\\nfunc TestCheckNames(t *testing.T) {\\n\\tnames := CheckNames()\\n\\texpected := []string{checkBuildReady, checkModuleHealth, checkDependencyIntegrity, checkNoPush}\\n\\n\\tgotLen := len(names)\\n\\tif gotLen != len(expected) {\\n\\t\\tt.Fatalf(errNameCountMismatch, len(expected), gotLen)\\n\\t}\\n\\n\\tfor i, want := range expected {\\n\\t\\tgot := names[i]\\n\\t\\tif got != want {\\n\\t\\t\\tt.Fatalf(errNameIndexMismatch, i, want, got)\\n\\t\\t}\\n\\t}\\n}\\n\",\"path\":\"pkg/release/payload_check_test.go\"}"
