ting.T) {\\n\\tchecker := NewPayloadChecker()\\n\\tresults := checker.CheckAll()\\n\\tok := AllPassed(results)\\n\\tif !ok {\\n\\t\\tt.Fatal(errManualCheckFailed)\\n\\t}\\n\\tpushed := checker.WasPushed()\\n\\tif pushed {\\n\\t\\tt.Fatal(errManualPushBlocked)\\n\\t}\\n}\\n\\n// TestCheckNames verifies the exported name list matches internal constants.\\nfunc TestCheckNames(t *testing.T) {\\n\\tnames := CheckNames()\\n\\texpected := []string{checkBuildReady, checkModuleHealth, checkDependencyIntegrity, checkNoPush}\\n\\n\\tgotLen := len(names)\\n\\tif gotLen != len(expected) {\\n\\t\\tt.Fatalf(errNameCountMismatch, len(expected), gotLen)\\n\\t}\\n\\n\\tfor i, want := range expected {\\n\\t\\tgot := names[i]\\n\\t\\tif got != want {\\n\\t\\t\\tt.Fatalf(errNameIndexMismatch, i, want, got)\\n\\t\\t}\\n\\t}\\n}\\n\",\"path\":\"pkg/release/payload_check_test.go\"}"
