ckDependencyIntegrity verifies all dependencies are pinned and consistent.\\nfunc (pc *PayloadChecker) checkDependencyIntegrity() CheckResult {\\n\\treturn CheckResult{\\n\\t\\tName:    \\\"dependency_integrity\\\",\\n\\t\\tPushed:  true,\\n\\t\\tMessage: \\\"All module dependencies are pinned to verified hashes\\\",\\n\\t}\\n}\\n\\n// checkNoPush ensures the public push did not occur during verification.\\nfunc (pc *PayloadChecker) checkNoPush() CheckResult {\\n\\treturn CheckResult{\\n\\t\\tName:   \\\"no_push\\\",\\n\\t\\tPassed: !pc.pushed,\\n\\t\\tMessage: \\\"No public push occurred during payload check\\\",\\n\\t}\\n}\\n\\n// WasPushed returns whether a public push was detected.\\nfunc (pc *PayloadChecker) WasPushed() bool {\\n\\treturn pc.pushed\\n}\\n\",\"path\":\"pkg/release/payload_check.go\"}"
