\\t\\tif AllPassed(mixed) {\\n\\t\\t\\tt.Error(\\\"mixed should be false\\\")\\n\\t\\t}\\n\\t})\\n}\\n\\nfunc TestPayloadChecker_ManualPushBlocked(t *testing.T) {\\n\\tpc := NewPayloadChecker()\\n\\tresults := pc.CheckAll()\\n\\tif !AllPassed(results) {\\n\\t\\tt.Fatal(\\\"manual push failed check\\\")\\n\\t}\\n\\tif pc.WasPushed() {\\n\\t\\tt.Error(\\\"push must be blocked by default\\\")\\n\\t}\\n}\\n\\nfunc TestCheckNames(t *testing.T) {\\n\\tnames := CheckNames()\\n\\texpected := []string{checkBuildReady, checkModuleHealth, checkDependencyIntegrity, checkNoPush}\\n\\tif len(names) != len(expected) {\\n\\t\\tt.Error(\\\"name count mismatch\\\")\\n\\t}\\n\\tfor i, want := range expected {\\n\\t\\tif names[i] != want {\\n\\t\\t\\tt.Error(\\\"name index mismatch at: \\\" + string(rune(i)))\\n\\t\\t}\\n\\t}\\n}\\n\",\"path\":\"pkg/release/payload_check_test.go\"}"
