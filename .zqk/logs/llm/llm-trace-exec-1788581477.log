            "description": "Waivers are human-authored durable objects only; agents must not self-waive.",
            "id": "VDS-R6"
          },
          {
            "description": "Empty dsl_checks or empty evidence_refs is a hard fail for any done claim.",
            "id": "VDS-R7"
          }
        ],
        "severity": "critical"
      },
