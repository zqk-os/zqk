{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://zqk.dev/schemas/cli_hook_profile.schema.json",
  "title": "CLI hook profile",
  "description": "Built-in automation hooks (enable/disable + optional tray entry). Written by zqk system cli-hooks. See pkg/clihooks.",
  "type": "object",
  "required": ["version", "hooks"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "hooks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "enabled"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "enabled": { "type": "boolean" },
          "tray_entry": { "type": "string", "description": "Optional tray entry name (zqk tray list)" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
