{"change_type":"update","changed_paths":["last_run_at","next_run_at"],"created_at":1788125416,"created_by":"ACC-1785920548450214012-68b850c0","diff_summary":"next_run_at: 2026-08-30T21:30:00Z -\u003e 2026-08-30T21:35:00Z; last_run_at: 2026-08-30T21:25:00Z -\u003e 2026-08-30T21:30:00Z","id":"CHA-998","kind":"change_journal_entry","object_ref":"scheduler_job:SCH-autofix-run","previous_state":{"category":"maintenance","command":"/bin/sh","command_args":["-c","set -e\nZQK=\"${ZQK_BIN:-zqk}\"\n\"$ZQK\" system check all --auto-fix --auto-fix-scheduler --timeout 540s"],"created_at":"2026-08-21T11:09:16Z","created_by":"ACC-1785920548450214012-68b850c0","description":"Runs `zqk system check all --auto-fix` every 5 minutes so auto-fixable issues\n(missing hashes, hash mismatches, etc.) are applied regularly and the system reaches\na good state without waiting for manual check --auto-fix.\nUses a full check surface (refs on): --fast is incompatible with --auto-fix.\nUses --timeout 540s (below max_runtime_seconds 600) so the CLI does not stop at the\ndefault ~2m floor for --auto-fix while proactive CAS cleanup and validation run.\n","enabled":true,"execution_mode":"reusable","id":"SCH-autofix-run","job_type":"run_wrapper","kind":"scheduler_job","last_run_at":"2026-08-30T21:25:00Z","max_runtime_seconds":600,"namespace_id":"zqk:kernel","next_run_at":"2026-08-30T21:30:00Z","schedule_expression":"0 */5 * * * *","schema_version":"2.0.0","source_type":"internal","status":"active","title":"Auto-fix run (every 5 min)","trigger_type":"timer","updated_at":"2026-08-30T21:25:12Z","updated_by":"ACC-1785920548450214012-68b850c0","version_context":"default"},"schema_version":"2.0.0","status":"pending","title":"Update: scheduler_job:SCH-autofix-run","updated_at":1788125416,"updated_by":"ACC-1785920548450214012-68b850c0"}
