*.go.txt
*.go.patch

# Test data
test-data/
test-scenarios/

# Scenario builder generated files (bootstrapping artifacts)
cmd/zqk/utility/docs/
cmd/zqk/utility/pkg/

# Process data (will be managed by CLI)
.zqk/process/**/*.hashes
.zqk/process/**/.*.hashes
.zqk/process/**/.hashes
.zqk/process/**/*.index
.zqk/process/**/.*.index
.zqk/process/**/.corporate_initiative.index.tmp-*
.zqk/process/**/*.yaml.tmp-*
docs/process/**/*.hashes
docs/process/**/.*.hashes
docs/process/**/.hashes
docs/process/**/*.index
docs/process/**/.*.index
# Corporate initiative index builder temps (atomic write before rename)
docs/process/**/.corporate_initiative.index.tmp-*
docs/process/**/*.yaml.tmp-*

# Lock files (temporary, auto-cleaned by FileLockStrategy)
.zqk/process/**/*.lock
.zqk/process/**/.*.lock
.zqk/process/**/.lock
docs/process/**/*.lock
docs/process/**/.*.lock
docs/process/**/.lock

# Audit events (high-volume, system-generated - not suitable for version control)
.zqk/process/audit/
docs/process/audit/

# Change journal entries (high-volume, system-generated - not suitable for version control)
.zqk/process/change_journal/
docs/process/change_journal/

# Metrics (high-volume, system-generated - includes scheduler_health_metric, file_lock_metric, command_metric, etc.)
.zqk/process/metrics/
docs/process/metrics/

# Scheduler jobs (high-volume runtime artifacts; temporary until docs/process -> .zqk migration)
.zqk/process/scheduler_jobs/
docs/process/scheduler_jobs/

# Local workspace metrics (command_metrics.json, object_volume/stream_volume chunks, baseline_metrics, etc.).
# Populated by CLI and scheduler; use zqk system audit-report, object-count-report, scripts/collect_baseline*.sh — not versioned.
.zqk/metrics/

# Pre-commit hook state (results.json, category JSON, lint/policy/integrity outputs). Populated by pre-commit scripts and timer jobs.
.zqk/pre-commit/

.zqk/diagnostics/
.zqk/scheduler/locks/

# Compliance output snapshots (generated)
.zqk/compliance-*.txt

# Ad-hoc Go literal scan dumps at repo root (e.g. for p in cmd cmdv2 pkg internal; do git grep … > ${p}_results.txt).
# Prefer: ./scripts/scan-hardcoded-go-literals.sh --out .zqk/logs/drift/go-literals-scan.txt
# System health snapshots (generated)
.zqk/system-health/

# MCP session dumps (runtime artifacts)
.zqk/process/mcp_sessions/
docs/process/mcp_sessions/
# Local .zqk used by cmd/zqk/internal (runtime)
cmd/zqk/internal/.zqk/
# Nested .zqk and docs under package dirs must not be used as project root; ignore if created by mistake
cmd/zqk/system/.zqk/
cmd/zqk/system/docs/

# Transient zqk object update payload (CLI --file helper)
tmp/cvs-update.yaml

# Local zip snapshots of docs/reports (see docs/archive/README.md); regenerate on demand
docs/archive/snapshots/*.zip

# Kernel state instances: all instance kernel objects are runtime data and must NEVER be tracked in git
.zqk/process/
docs/process/
.zqk-state/
# Prior csnap archives (state-commit copies before overwrite) — keep in git for rollback
!.zqk-state/snapshots/
!.zqk-state/snapshots/**/*.csnap

.zqk/agent-runtime/*
!.zqk/agent-runtime/*.example
!.zqk/agent-runtime/agent_chat_channel.json
!.zqk/agent-runtime/agent_idle_store.json
.zqk/agent_packs/
.zqk/ides/
# Cursor stdio MCP spawn env (API key + session); never commit.
.zqk/mcp/cursor-stdio.env
.zqk/mcp/*.env.local
.zqk/mcp/*.pid
# No trailing slash: leftover symlink or seedAgentWorktreeRuntime plant is not a
# directory, so object_drafts/ stays dirty as executor leftover.
# TRACK: BLI-COMMS-ORCH-DRAFT-PLANE-DIRTY-001
.zqk/object_drafts
.zqk/scratch_*.json
.zqk/scratch_*.txt
/scratch_whatsnext*.json
# Agent CLI scratch dumps (object list --file payloads, bulk updates)
/tmp_*.json
/.tmp_*.json
/all_atks.json
/update_atk.json
.zqk/mcp_sessions/

