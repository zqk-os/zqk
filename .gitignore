# zqk
# Prevent nested .zqk directories from test data pollution (POL-CODE-006).
# Go test CWD is the package directory; poorly isolated tests can create .zqk/ there.
**/.zqk/
!/.zqk
**/.zqk/logs/
**/.zqk/scheduler/
**/.zqk/streams/
.agents/*
.zqk/**/*.lock
.zqk/autofix/
.zqk/cache/
.zqk/testscan_cache.json
# Private signing keys. Nothing here has ever been tracked; this keeps it that way,
# because one `git add -A` in a repo with public-push gates is all it would take.
.zqk/keystore/
.zqk/stream_summary/
.zqk/scheduler/
.zqk/state/
.zqk/seating/
.zqk/credentials
.zqk/streams/
.zqk/tmp/
# Ephemeral scratch at .zqk root (CLI --file payloads, scans). Use .zqk/tmp/ instead.
/.zqk/tmp-*
/.zqk/tmp_*
/.zqk/temp-*
/.zqk/temp_*
.zqk/drafts/
# Per-ATK git worktrees (local agent workspaces; must not pollute pre-commit / agent-validate)
.zqk/worktrees/
.zqk/wal/
# System-managed resources container (CAS indices, snapshots)
.zqk/system-state/cas-indices/
.zqk/system-state/snapshots/
!.zqk/system-state/README.md  # Track README for documentation
/zqk
/zqk-mcp


